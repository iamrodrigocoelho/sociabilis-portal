# Obtenha sua chave em https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Endereço remetente verificado no Resend (domínio precisa estar verificado)
RESEND_FROM=Sociabilis AI Labs <contato@seudominio.com.br>

# E-mail de destino para onde as mensagens do formulário serão enviadas
CONTACT_EMAIL=seuemail@seudominio.com.br

# Chave secreta do reCAPTCHA v3 (obtida em https://www.google.com/recaptcha/admin)
# Deixe vazio para desabilitar a verificação server-side
RECAPTCHA_SECRET_KEY=

# Pontuação mínima do reCAPTCHA v3 para aceitar o envio (0.0 a 1.0; padrão 0.5).
# Se mensagens legítimas forem recusadas (veja "reCAPTCHA recusado" nos logs), reduza para 0.3.
RECAPTCHA_MIN_SCORE=0.5

# Porta do servidor (padrão: 3001)
PORT=3001

# Proxy reverso: define de onde vem o IP do visitante (usado no limite de envios do formulário).
# "loopback" (padrão) confia em proxy na mesma máquina; use "1" se houver um proxy à frente do app.
TRUST_PROXY=loopback
