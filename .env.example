# Obtenha sua chave em https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Endereço remetente verificado no Resend (domínio precisa estar verificado)
RESEND_FROM=Sociabilis AI Labs <contato@seudominio.com.br>

# E-mail de destino para onde as mensagens do formulário serão enviadas
CONTACT_EMAIL=seuemail@seudominio.com.br

# Chave secreta do reCAPTCHA v2 (obtida em https://www.google.com/recaptcha/admin)
# Deixe vazio para desabilitar a verificação server-side
RECAPTCHA_SECRET_KEY=

# Porta do servidor (padrão: 3001)
PORT=3001
